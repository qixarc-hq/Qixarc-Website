{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 ../scripts/build-pages.py && python3 ../scripts/test-seo.py",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/demo",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/demo/",
      "destination": "/products/",
      "permanent": true
    },
    {
      "source": "/why-qixarc",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/why-qixarc/",
      "destination": "/about/",
      "permanent": true
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy/",
      "permanent": true
    },
    {
      "source": "/terms-of-service",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/terms-of-service/",
      "destination": "/terms/",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/research/",
      "permanent": true
    },
    {
      "source": "/pricing/",
      "destination": "/research/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' https://iosmotdjsrwuktpzrxvu.supabase.co wss://iosmotdjsrwuktpzrxvu.supabase.co; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
