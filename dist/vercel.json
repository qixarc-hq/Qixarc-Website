{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 ../scripts/export-published.py --fetch && python3 ../scripts/build-pages.py && python3 ../scripts/test-seo.py",
  "outputDirectory": ".",
  "trailingSlash": true,
  "redirects": [
    { "source": "/pricing", "destination": "/research/", "permanent": true },
    { "source": "/pricing/", "destination": "/research/", "permanent": true }
  ],
  "headers": [
    { "source": "/admin/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}
